{
	"name": "vdg-webapp",
	"version": "1.0.0",
	"packageManager": "pnpm@10.10.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write .",
		"check-types": "turbo run check-types",
		"clean_modules": "find . -type d -name \"node_modules\" -exec rm -r {} +",
		"clean_build": "find . -type d -name \"dist\" -exec rm -r {} +",
		"clean_svelte": "find . -type d -name \".svelte-kit\" -exec rm -r {} +",
		"clean_files": "find . -name \"*.d.ts*\" -delete",
		"clean": "pnpm clean_modules; pnpm clean_build; pnpm clean_svelte; pnpm clean_files"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"prettier": "^3.5.3",
		"prettier-plugin-merge": "^0.7.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"turbo": "^2.5.3"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@trivago/prettier-plugin-sort-imports": "^5.2.2"
	},
	"pnpm": {
		"overrides": {
			"canvas": "npm:@napi-rs/canvas@0.1.69",
			"svelte": "5.34.0"
		}
	}
}
