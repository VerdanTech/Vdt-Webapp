{
	"name": "vdg-webapp",
	"version": "1.0.0",
	"packageManager": "pnpm@10.10.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write .",
		"check-types": "turbo run check-types",
		"clean_modules": "find . -type d -name \"node_modules\" -exec rm -r {} +",
		"clean_build": "find . -type d -name \"dist\" -exec rm -r {} +",
		"clean_svelte": "find . -type d -name \".svelte-kit\" -exec rm -r {} +",
		"clean_files": "find . -name \"*.d.ts*\" -delete",
		"clean": "pnpm clean_modules; pnpm clean_build; pnpm clean_svelte; pnpm clean_files"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-merge": "^0.10.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"turbo": "^2.9.6"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2"
	},
	"pnpm": {
		"overrides": {
			"canvas": "npm:@napi-rs/canvas@0.1.69",
			"svelte": "5.55.5"
		},
		"onlyBuiltDependencies": [
			"argon2",
			"core-js",
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
